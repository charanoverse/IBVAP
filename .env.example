# =================================================================
# IBVAP - Intelligent Border Video Analytics Platform
# Environment Configuration Template (Phase 3 — AI Object Detection)
# =================================================================

# Server Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/ibvap_dev.sqlite

# Storage Directories
STORAGE_VIDEOS_PATH=./data/videos
STORAGE_SNAPSHOTS_PATH=./data/snapshots
STORAGE_EVIDENCE_PATH=./data/evidence

# Configuration Paths
CONFIG_CAMERAS_PATH=./config/cameras
CONFIG_ZONES_PATH=./config/zones
CONFIG_RULES_PATH=./config/rules

# AI Object Detection Pipeline (Phase 3)
AI_ENABLED=true
AI_MODEL=yolov8n.pt
AI_MODEL_PATH=./ai/models/yolov8n.pt
AI_CONFIDENCE_THRESHOLD=0.40
AI_IOU_THRESHOLD=0.45
AI_INFERENCE_FPS=5
AI_DEVICE=auto
AI_CLASSES=person,car,motorcycle,bus,truck
AI_SERVICE_PORT=5001
AI_PERSISTENCE_ENABLED=true
AI_PERSISTENCE_INTERVAL=5
PYTHON_PATH=python

# Logging Configuration
LOG_LEVEL=INFO

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://127.0.0.1:4000/api
